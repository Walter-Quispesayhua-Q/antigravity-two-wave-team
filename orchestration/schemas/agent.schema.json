{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Antigravity Adaptive Agent Profile",
  "description": "Project-owned schema for automatically discovered Antigravity subagents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "description",
    "systemPrompt",
    "skills",
    "routing",
    "runtime",
    "outputContract"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "systemPrompt": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "activation",
        "priority",
        "cost",
        "capabilities",
        "taskTypes",
        "triggers",
        "exclusions"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "wave-1",
            "wave-2"
          ]
        },
        "activation": {
          "type": "string",
          "enum": [
            "default-evidence",
            "conditional",
            "verifier"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cost": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/routingTerms"
        },
        "taskTypes": {
          "$ref": "#/$defs/routingTerms"
        },
        "triggers": {
          "$ref": "#/$defs/routingTerms"
        },
        "exclusions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "enableMcpTools",
        "enableWriteTools",
        "enableSubagentTools"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "custom"
        },
        "enableMcpTools": {
          "type": "boolean"
        },
        "enableWriteTools": {
          "type": "boolean"
        },
        "enableSubagentTools": {
          "type": "boolean"
        }
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "requiredSections",
        "evidenceRequired"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "markdown",
            "json"
          ]
        },
        "requiredSections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRequired": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "routingTerms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    }
  }
}
